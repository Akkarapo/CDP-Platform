# Google OAuth Client ID (Web application) — required for real "Sign in with Google".
# Create one at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 and your Vercel domain(s).
VITE_GOOGLE_CLIENT_ID=

# Supabase browser configuration. Use the project URL and publishable key;
# never put the service_role key in a VITE_ environment variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini API key — server-side only (no VITE_ prefix). Powers AI campaign
# copy generation in api/generate-campaign.ts. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LINE Messaging API — server-side only (no VITE_ prefix; never sent to the
# browser). Create a channel at https://developers.line.biz/console/ and set
# its Webhook URL to https://<your-domain>/api/line-webhook (shown with a
# copy button on the Settings page).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OA_BASIC_ID=

# Supabase service_role key — server-side only, never sent to the browser.
# Bypasses RLS, so it's used only by api/line-webhook.ts and
# api/line-sync-followers.ts to write the line_users roster. Find it at
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
